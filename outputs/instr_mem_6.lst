addr  machine code       source
----  -----------------  ------
00    1101000001101111  D06F  addi $sp, $zero, 0b1111   ; auto: $sp init
01    1101000000010000  D010  addi $t0, $zero, 0
02    1101000000100101  D025  addi $t1, $zero, 5
                         loop:
03    0100000100100001  4121  add $t0, $t0, $t1
04    1100001000100001  C221  subi $t1, $t1, 1
05    0000001000001101  020D  bneq $t1, $zero, loop
06    1011000100011110  B11E  andi $t0, $t0, 14
07    0001000100010001  1111  srl $t0, $t0, 1
08    1101000100010001  D111  addi $t0, $t0, 1
09    0100000100000001  4101  add $t0, $t0, $zero
                         halt:
0A    0110000010100000  60A0  j halt

labels
  loop         03
  halt         0A
